# ==============================================================
# TG-SYSTEM-CONTROL CONFIGURATION
# Copy to .env and fill in your own values. Never commit .env.
# ==============================================================

# Telegram bot token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your numeric Telegram user ID from @userinfobot. ONLY this chat can control the PC.
# The bot refuses to start while this is empty.
TELEGRAM_CHAT_ID=your_telegram_chat_id

# AI translator for Hinglish / free text: "gemini", "openrouter", "groq", or "offline".
# If the selected provider has no API key, the bot runs in offline mode (exact commands only).
LLM_PROVIDER=gemini

# API keys (only the one for LLM_PROVIDER is needed)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-70b

# Optional: comma-separated Gemini model(s) to try before the built-in fallback list
# GEMINI_MODEL=gemini-flash-lite-latest

# ---------------- Agent mode (/agent, /do: "do anything on this PC") ----------------
# Needs GEMINI_API_KEY (the agent sends screenshots to Gemini to decide each click).
AGENT_ENABLED=true
# Optional: comma-separated vision model(s) to try first (fallbacks are built in)
# AGENT_MODEL=gemini-flash-latest
AGENT_MAX_STEPS=30
# Ask for ✅/❌ before risky steps (sending, buying, deleting, installing, shell changes). Keep true.
AGENT_REQUIRE_APPROVAL=true
APPROVAL_TIMEOUT_SEC=300
# How text is typed: "paste" (clipboard + Ctrl+V, reliable even when the PC is busy) or "keys" (key by key)
TYPE_METHOD=paste
# Send a screenshot (mouse marked) after every mouse/keyboard command, like a remote desktop
REMOTE_FEEDBACK=true
# Where photos/files you send to the bot are saved
# INBOX_DIR=%USERPROFILE%\Downloads\TelegramInbox

# ---------------- Video Studio bot (bot 2, separate video pipeline) ----------------
# /studio start|stop|restart|status|logs controls <VIDEOSTUDIO_DIR>\tools\videostudio_bot.py
# Start the Video Studio bot automatically whenever this bot starts (true/false)
STUDIO_AUTOSTART=true
# VIDEOSTUDIO_DIR=D:\VideoStudio_Mac
# VIDEOSTUDIO_PYTHON=D:\VideoStudio_Mac\.venv\Scripts\pythonw.exe

# Optional: path to the Hermes desktop app (for "open hermes")
# HERMES_APP_PATH=D:\git-data\hermes-agent\apps\desktop\release\win-unpacked\Hermes.exe

# ---------------- Antigravity bridge (who answers the Video Studio bot) ----------------
# Types Video Studio bot messages into the Antigravity desktop app; Antigravity replies via that bot.
ANTIGRAVITY_BRIDGE=true
ANTIGRAVITY_PROJECT=CannonBreak Channel
# ANTIGRAVITY_EXE=%LOCALAPPDATA%\Programs\Antigravity\Antigravity.exe
# ANTIGRAVITY_BUSY_WAIT_SEC=900

# Element listing backend: leave empty (UI Automation 3, recommended) or "powershell" for the old helper
# UIA_BACKEND=
